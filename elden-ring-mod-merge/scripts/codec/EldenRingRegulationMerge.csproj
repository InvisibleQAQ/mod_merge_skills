<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Andre.Core"><HintPath>$(SmithboxDir)\Andre.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Andre.Formats"><HintPath>$(SmithboxDir)\Andre.Formats.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Andre.SoulsFormats"><HintPath>$(SmithboxDir)\Andre.SoulsFormats.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateSmithboxDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SmithboxDir)' == '' Or !Exists('$(SmithboxDir)/Andre.Formats.dll')" Text="Provide -p:SmithboxDir pointing to a complete Smithbox release directory." />
  </Target>
</Project>
